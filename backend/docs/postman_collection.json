            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Servidor Dell PowerEdge R750 (Upgrade RAM)\",\n  \"status\": \"active\",\n  \"cost\": 5200.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/assets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "assets", "1"]
            }
          }
        },
