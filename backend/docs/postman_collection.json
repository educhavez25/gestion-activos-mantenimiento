              "raw": "{\n  \"code\": \"ACT-SERV-009\",\n  \"name\": \"Servidor Dell PowerEdge R750\",\n  \"description\": \"Servidor dedicado para bases de datos principales.\",\n  \"category_id\": 1,\n  \"location_id\": 1,\n  \"assigned_user_id\": 19,\n  \"status\": \"active\",\n  \"purchase_date\": \"2026-01-15\",\n  \"cost\": 4500.00\n}"
            },
            "url": {
