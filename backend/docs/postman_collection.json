    {
      "name": "3. Módulo de Activos",
      "item": [
        {
          "name": "GET Listar Activos (Paginado + Filtros)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/assets?status=active&sort_by=created_at&sort_direction=desc&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "assets"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "sort_by", "value": "created_at" },
                { "key": "sort_direction", "value": "desc" },
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
